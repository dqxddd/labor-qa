# 复制这份文件为 .env 再改，别直接改这个文件
# .env 不会提交到压缩包里

# ==================== 应用 ====================
APP_NAME=劳动权益咨询问答台
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# ==================== 大模型 ====================
# 不填 key 也能跑，问答接口会降级成"只返回检索到的依据"
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
# 下面三个是前端左栏「模型参数」面板的兜底默认值：
# 面板上没调过的参数就用这里的值。注意有的模型会把参数锁死
# （kimi-k3 只认 temperature=1、top_p=0.95），锁死的以模型为准，
# 具体锁了哪些写在 core/config.py 的 MODEL_LOCKS 里。
LLM_TOP_P=1.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# ==================== 向量模型 ====================
# 向量检索用。EMBED_PROVIDER=api 走在线接口（推荐，免费、中文效果好）。
# 硅基流动的填法：EMBED_API_KEY 填和上面 LLM_API_KEY 同一把 key，
# EMBED_BASE_URL=https://api.siliconflow.cn/v1，模型用 BAAI/bge-m3。
# 不填 key 也不影响系统运行：向量检索不可用时会自动降级用关键词检索，
# 页面上会如实提示"本轮走了兜底检索"。
# 想完全离线就把 EMBED_PROVIDER 改成 local，另需装 torch + sentence-transformers。
EMBED_PROVIDER=api
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
EMBED_BASE_URL=

# ==================== 知识库切分 ====================
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ==================== 检索 ====================
TOP_K=5
# 拒答分数线。两条检索路的分数口径不一样，所以分成两个配置项：
#   向量分是余弦相似度，相关的一般 0.6 以上、不相关的 0.3~0.45，所以定 0.55
#   关键词分是查询词覆盖率，相关的一般只有 0.2~0.4，所以定 0.35
# 这两个值是拿库内/库外各十几个问题实测标定出来的，别随手改小 ——
# 向量阈值调低到 0.35 会把"怎么申请专利"这种库外问题也判成命中，拒答直接失效。
VECTOR_SCORE_THRESHOLD=0.55
SCORE_THRESHOLD=0.35

# ==================== 会话 ====================
# 前端「历史对话轮数」滑块的兜底默认值，面板上调过就以面板为准
HISTORY_TURNS=8

# ==================== 业务工具 ====================
# 总开关。开着的时候，问到"我还来得及仲裁吗"这类期限问题，后端会调
# arbitration_limit 工具把截止日算出来（仲裁时效 / 追索报酬 / 工伤认定三类），
# 调用记录写进 tool_calls 表，界面上会显示算的过程。
# 改成 false 就完全不碰工具，问答链路跟加工具之前一模一样 ——
# 报告里想对比"有工具 / 没工具"两种效果时用得上。
TOOL_ENABLED=true
